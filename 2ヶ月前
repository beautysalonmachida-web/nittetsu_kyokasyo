function send2MonthNotification() {
  // --- ヘルパー関数: 月末バグを回避した月加算 ---
  function addMonths(date, months) {
    const result = new Date(date);
    const day = result.getDate();
    result.setMonth(result.getMonth() + months);
    if (result.getDate() !== day) {
      result.setDate(0); // 前月の末日にセット
    }
    return result;
  }

  // --- 1. スプレッドシートとシートの情報を取得 ---
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const permitSheet = ss.getSheetByName('許可証');
  const settingSheet = ss.getSheetByName('メール設定');

  if (!permitSheet || !settingSheet) {
    Logger.log('「許可証」または「メール設定」シートが見つかりません。処理を中断します。');
    return;
  }

  // --- 2. 送信先のメールアドレスを取得 ---
  const emailAddresses = settingSheet.getRange('B2:B' + settingSheet.getLastRow()).getValues().flat().filter(String);
  if (emailAddresses.length === 0) {
    Logger.log('送信先のメールアドレスが「メール設定」シートに見つかりません。');
    return;
  }

  // --- 3. 日付の準備 ---
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const twoMonthsLater = addMonths(today, 2);

  // --- 4. データ取得と条件判定 ---
  const lastRow = permitSheet.getLastRow();
  if (lastRow < 2) {
    Logger.log('許可証のデータがありません。');
    return;
  }

  const data = permitSheet.getRange(2, 1, lastRow - 1, 12).getValues(); // L列(12)まで取得
  const expiringPermits = [];

  for (let i = 0; i < data.length; i++) {
    const row = data[i];
    const permitDate = new Date(row[4]); // E列

    if (isNaN(permitDate.getTime())) {
      continue;
    }

    const updateStatus = row[6];  // G列
    const noticeStatus = row[11]; // L列（2ヶ月前通知）
    const meisyou = row[0];       // A列

    if (permitDate >= today && permitDate <= twoMonthsLater
        && updateStatus !== '申請中'
        && meisyou !== '産業廃棄物処分業許可証【最終処分業'
        && noticeStatus !== '2ヶ月通知済み') {
      expiringPermits.push({
        rowIndex: i + 2,
        details: row
      });
    }
  }

  if (expiringPermits.length === 0) {
    Logger.log('該当するデータはありません。処理を中断し、メールは送信されません。');
    return;
  }

  // --- 5. メールの作成と送信 ---
  const subject = '【要確認】許可書有効期限のお知らせ';
  let emailBody = '以下の許可書の有効期限が2ヶ月以内です:\n\n';
  const timeZone = Session.getScriptTimeZone();

  expiringPermits.forEach(permit => {
    const details = permit.details;
    const formattedPermitDate = Utilities.formatDate(new Date(details[4]), timeZone, 'yyyy/MM/dd');
    emailBody += `許可書名称: ${details[0]}\n許可地: ${details[1]}\n許可番号: ${details[2]}\n許可有効年月日: ${formattedPermitDate}\n備考: ${details[5]}\n\n`;
  });

  emailBody += '\n更新はこちらのアプリから\nhttps://www.appsheet.com/start/20bd829d-6f34-4f48-95c1-25c1bbb4a8e8\n\n';
  emailBody += 'スマホの場合はこちら\nhttps://www.appsheet.com/newshortcut/20bd829d-6f34-4f48-95c1-25c1bbb4a8e8\n';

  try {
    const recipients = emailAddresses.join(',');
    MailApp.sendEmail(recipients, subject, emailBody);
    Logger.log('メールを ' + recipients + ' に送信しました。');
  } catch (e) {
    Logger.log('メール送信に失敗しました: ' + e.message);
    return;
  }

  // --- 6. シートの更新（L列: 2ヶ月前通知）---
  expiringPermits.forEach(permit => {
    permitSheet.getRange(permit.rowIndex, 12).setValue('2ヶ月通知済み');
  });
  Logger.log(expiringPermits.length + '件のステータスを「2ヶ月通知済み」に更新しました。');
}
